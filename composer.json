{
    "name": "realitaa/phpvite",
    "description": "Modern Plain PHP + Vite 8 Vanilla JS Starter Template",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Realitaa\\PhpVite\\": "app/",
            "Database\\": "database/"
        },
        "files": [
            "app/Vite/helpers.php",
            "app/Support/helpers.php"
        ]
    },
    "require": {
        "php": "^8.2",
        "vlucas/phpdotenv": "^5.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "spatie/fork": "^1.2.0, <=1.2.6",
        "fakerphp/faker": "^1.24"
    },
    "scripts": {
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php bin/dev.php"
        ],
        "db:pdo": "@php bin/pdo.php",
        "db:migrate": "@php bin/migrate.php",
        "db:migrate:fresh": "@php bin/fresh.php",
        "db:seed": "@php bin/seed.php",
        "test": "phpunit"
    }
}
